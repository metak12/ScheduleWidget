<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Полупрозрачный темный фон в тон стеклянным иконкам -->
    <solid android:color="#551E2229" />
    <!-- Скругленные края как у плашки внизу экрана -->
    <corners android:radius="26dp" />
    <!-- Тонкая полупрозрачная белая окантовка стекла -->
    <stroke
        android:width="1.2dp"
        android:color="#50FFFFFF" />
</shape>
